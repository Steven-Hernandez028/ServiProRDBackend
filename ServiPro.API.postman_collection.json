              "mode": "raw",
              "raw": "{\"email\": \"client@example.com\", \"password\": \"Password123!\", \"name\": \"Juan Pérez\", \"city\": \"Santo Domingo\", \"phone\": \"+1234567890\", \"address\": \"Calle Principal 123\"}"
